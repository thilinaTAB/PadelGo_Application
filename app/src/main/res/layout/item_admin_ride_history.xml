<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User: "
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_txt_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading user..." />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bike: "
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_txt_bike_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unknown Bike" />
        </LinearLayout>

        <TextView
            android:id="@+id/item_txt_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Location: Unknown Location" />

        <TextView
            android:id="@+id/item_txt_plan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Plan: Unknown Plan" />

        <TextView
            android:id="@+id/item_txt_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Amount: Unknown Amount" />

        <TextView
            android:id="@+id/item_txt_date_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Date/Time: Unknown" />

        <TextView
            android:id="@+id/item_txt_order_placed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Order Placed: Unknown" />

        <TextView
            android:id="@+id/item_txt_payment_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Payment: Unknown" />

        <TextView
            android:id="@+id/item_txt_ride_requested"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ride Requested?: Not yet" />

        <TextView
            android:id="@+id/item_txt_ride_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ride Time: -" />

    </LinearLayout>
</androidx.cardview.widget.CardView>