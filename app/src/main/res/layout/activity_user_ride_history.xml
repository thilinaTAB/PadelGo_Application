<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDECED"
    android:orientation="vertical"
    tools:context=".user.RideHistory">

    <!-- HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/header_gradient"
        android:padding="16dp">

        <ImageView
            android:id="@+id/IMGBTN_Back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back Button"
            android:padding="4dp"
            android:src="@drawable/backbutton"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/textView_title_user_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="My Ride History"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- MESSAGE FOR LOADING/EMPTY -->
    <TextView
        android:id="@+id/txt_user_history_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:text="Loading ride history..."
        android:textColor="@color/textPrimary"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- RIDE HISTORY LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_user_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</LinearLayout>
