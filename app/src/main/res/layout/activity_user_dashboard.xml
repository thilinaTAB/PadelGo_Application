<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDECED"
    tools:context=".user.UserDashboard">

    <RelativeLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/top_view"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/dash_header_gradient"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/greetingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Main Grid Layout -->
        <GridLayout
            android:id="@+id/gridLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/top_view"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="-32dp"
            android:layout_marginRight="16dp"
            android:columnCount="2"
            android:rowCount="3">

            <!-- Profile Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/CV_Profile"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="0"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/IMG__UserProfile"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/reg_name"
                        app:tint="@color/primaryColor" />

                    <TextView
                        android:id="@+id/TXTBTN_UserProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Profile"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Packages Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/CV_Packages"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="0"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/IMG_Packages"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/bicycle_ico"
                        app:tint="@color/primaryColor" />

                    <TextView
                        android:id="@+id/TXTBTN_BicycleList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Blicycles"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Rent Now Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/CV_RentNow"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="0"
                android:layout_columnSpan="2"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:backgroundTint="@color/primaryLightColor"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/IMG_rent"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/rental_bicycle_ico"
                        app:tint="@color/primaryColor" />

                    <TextView
                        android:id="@+id/TXTBTN_rent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Rent Now"
                        android:textColor="@color/primaryColor"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- My Rides Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/CV_MyRides"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="0"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/IMG_MyRides"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/money_ico"
                        app:tint="@color/primaryColor" />

                    <TextView
                        android:id="@+id/TXTBTN_MyRides"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="My Rides"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- History Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/CV_History"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="0"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/white"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/IMGBTN_History"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/history"
                        app:tint="@color/primaryColor" />

                    <TextView
                        android:id="@+id/TXTBTN_History"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="History"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Settings Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/CV_Settings"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="0"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/IMG_settings"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/settings_ico"
                        app:tint="@color/primaryColor" />

                    <TextView
                        android:id="@+id/TXTBTN_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Settings"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sign Out Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/CV_SignOut"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="0"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/IMG_signOut"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/logout_ico"
                        app:tint="@color/errorColor" />

                    <TextView
                        android:id="@+id/TXTBTN_signOut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Sign Out"
                        android:textColor="@color/errorColor"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </GridLayout>
    </RelativeLayout>
</ScrollView>